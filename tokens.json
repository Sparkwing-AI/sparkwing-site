        "usage": "Price highlights and sparks on teal only"
      },
      {
        "foreground": "sparkGold",
        "background": "nightFern",
        "ratio": 4.52,
        "rating": "AA",
        "usage": "Gold accents on deepest teal"
      },
      {
        "foreground": "gladeTeal",
        "background": "cloudWhite",
        "ratio": 4.86,
        "rating": "AA",
        "usage": "Panel tile body copy"
      },
      {
        "foreground": "lagoonTeal",
        "background": "cloudWhite",
        "ratio": 4.55,
