---
import '../styles/page.css';
import '../styles/apps.css';
import Badge from './Badge.astro';
import Button from './Button.astro';
import CanvasHero from './CanvasHero.astro';
import ProductNav from './ProductNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps, type AppId } from '../config/apps';

interface Props {
  id: AppId;
}

const app = apps[Astro.props.id];
---

<BaseLayout title={app.title} description={app.description}>
  <ProductNav current={app.id} />

  <CanvasHero scene={app.id} titleId="app-title" label={app.sceneLabel}>
    <div class="mx-text" slot="copy">
      <span class="mx-mark">
        <img src={app.logo} alt="" width="56" height="56" />
        <Badge size="lg">Coming soon</Badge>
      </span>
      <h1 class="mx-h1" id="app-title">{app.name}</h1>
      <p class="mx-lead">{app.promise}</p>
      <p class="mx-p">{app.body}</p>
      <div class="mx-cta">
        <Button variant="accent" size="lg" enquiry="app">Ask us about this app</Button>
      </div>
    </div>
    <Fragment slot="stage">
      {
        app.id === 'magnet' && (
          <>
            <span class="mx-tile mx-tile--mid" data-tile><img src={app.logo} alt="" width="60" height="60" /></span>
            <span class="mx-chip mx-at-l6-t14" data-in>Enquiries</span>
            <span class="mx-chip mx-at-l2-t74" data-in>Reminders</span>
            <span class="mx-chip mx-at-l68-t6" data-in>Campaigns</span>
            <span class="mx-chip mx-at-r0-t82" data-out>New client in Sparkkeeper</span>
          </>
        )
      }
      {
        app.id === 'academy' && (
          <>
            <span class="mx-chip mx-at-l0-t88" data-step>Short courses</span>
            <span class="mx-chip mx-at-l22-t37" data-step>Safe AI habits</span>
            <span class="mx-chip mx-at-l48-t75" data-step>Everyday work</span>
            <span class="mx-tile mx-tile--academy" data-tile data-end><img src={app.logo} alt="" width="60" height="60" /></span>
            <span class="mx-chip mx-at-r0-t30" data-end>Unlocks other apps</span>
          </>
        )
      }
      {
        app.id === 'nest' && (
          <>
            <span class="mx-tile mx-tile--nest" data-tile><img src={app.logo} alt="" width="60" height="60" /></span>
            <span class="mx-chip mx-at-l6-t6" data-in>AI news</span>
            <span class="mx-chip mx-at-l38-t0" data-in>Announcements</span>
            <span class="mx-chip mx-at-r4-t8" data-in>Training</span>
            <span class="mx-chip mx-at-r0-t88" data-in>App access</span>
          </>
        )
      }
    </Fragment>
  </CanvasHero>

  <section class="sw-band sw-band--surface sw-base" aria-labelledby="fit-title">
    <div class="sw-base-grid">
      <h2 class="sw-base-title" id="fit-title">Runs on the same trusted base as every Sparkwing app.</h2>
      <div class="sw-base-copy">
        <p>
          Hive knows your business, AI Crew does the work, and Control Tower decides what's allowed and keeps the receipts. Add this app later and nothing your team already uses has to change.
        </p>
        <a class="sw-link" href="/trust">How the base platform works</a>
      </div>
    </div>
  </section>
</BaseLayout>
