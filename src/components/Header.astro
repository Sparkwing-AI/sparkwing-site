---
import Button from './Button.astro';
import { pageLinks } from '../config/nav';
import { mailto } from '../config/site';

interface Props {
  /** Current path, used to mark the current page link. */
  path?: string;
  /** Sits on a dark hero. Solid deep teal on every other page. */
  overlay?: boolean;
}

const { path = '', overlay = false } = Astro.props;
const current = (href: string) => (path === href ? 'page' : undefined);
---

<header class:list={['sw-header', overlay && 'sw-header--overlay']} data-header>
  <div class="sw-nav">
    <div class="sw-nav-row sw-container">
      <a class="sw-logo" href="/">
        <img src="/assets/sparkwing-mark.png" alt="" width="44" height="44" decoding="async" />
        <span class="sw-logo-name">Sparkwing</span>
        <span class="sw-visually-hidden"> home</span>
      </a>
      <div class="sw-nav-cluster">
        <nav class="sw-nav-links" aria-label="Main">
          {pageLinks.map((link) => (
            <a class="sw-nav-link" href={link.href} aria-current={current(link.href)}>{link.label}</a>
          ))}
        </nav>
        <div class="sw-nav-right">
          <Button class="sw-nav-book" variant="accent" size="sm" enquiry="call">Book a discovery call</Button>
          <button class="sw-menu-btn" type="button" aria-expanded="false" aria-controls="sw-menu" aria-label="Menu" data-menu-toggle>
            <span class="sw-menu-icon" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div id="sw-menu" class="sw-menu" hidden>
    <div class="sw-menu-pages">
      {pageLinks.map((link) => (
        <a href={link.href} aria-current={current(link.href)}>{link.label}</a>
      ))}
      <a class="sw-menu-pages-action" href={mailto} data-enquiry="call">Book a discovery call</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const panel = document.getElementById('sw-menu');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  function setOpen(open: boolean, returnFocus = false) {
    if (!panel || !toggle) return;
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close' : 'Menu');
    if (!open && returnFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => {
    setOpen(Boolean(panel?.hidden));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && panel && !panel.hidden) setOpen(false, true);
  });

  document.addEventListener('click', (event) => {
    if (!panel || panel.hidden || !header) return;
    if (header.contains(event.target as Node)) return;
    setOpen(false);
  });

  document.addEventListener('sw:enquiry-open', () => setOpen(false));

  if (header?.classList.contains('sw-header--overlay')) {
    const markStuck = () => header.classList.toggle('is-stuck', window.scrollY > 4);
    markStuck();
    window.addEventListener('scroll', markStuck, { passive: true });
  }
</script>
