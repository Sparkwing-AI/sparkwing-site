---
import Button from './Button.astro';
import { footerColumns } from '../config/nav';
import { company, mailto, tel } from '../config/site';
---

<footer class="sw-footer">
  <div class="sw-footer-inner">
    <div class="sw-footer-cta">
      <h2>Ready to transform how your business works? Let's talk.</h2>
      <Button variant="accent" size="lg" enquiry="call">Book a discovery call</Button>
    </div>
    <div class="sw-footer-cols">
      {
        footerColumns.map((column) => (
          <div class="sw-footer-col">
            <p class="sw-eyebrow">{column.heading}</p>
            {column.links.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        ))
      }
      <div class="sw-footer-col">
        <p class="sw-eyebrow">SAY HELLO</p>
        <a href={mailto}>{company.email}</a>
        <a href={tel}>{company.phone}</a>
        <a href="/contact">Contact us</a>
        <span>Based in Sydney. Working with businesses across Australia.</span>
      </div>
    </div>
    <p class="sw-footer-legal">
      {company.legalName} · ABN {company.abn} · {company.location} · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a>
    </p>
  </div>
</footer>
