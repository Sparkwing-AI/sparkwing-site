---
import { footerColumns } from '../config/nav';
import { company, mailto, tel } from '../config/site';
---

<footer class="sw-footer">
  <div class="sw-footer-inner">
    <div class="sw-footer-top">
      <div class="sw-footer-brand">
        <a class="sw-footer-logo" href="/">
          <img src="/assets/sparkwing-mark.png" alt="" width="28" height="28" decoding="async" />
          <span>Sparkwing</span>
        </a>
        <p>Take flight with AI you can trust.</p>
      </div>
      <div class="sw-footer-cols">
        {
          footerColumns.map((column) => (
            <div class="sw-footer-col">
              <p class="sw-footer-heading">{column.heading}</p>
              {column.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          ))
        }
        <div class="sw-footer-col">
          <p class="sw-footer-heading">Contact</p>
          <a href={mailto}>{company.email}</a>
          <a href={tel}>{company.phone}</a>
          <a href="/contact">Contact us</a>
        </div>
      </div>
    </div>
    <p class="sw-footer-legal">
      {company.legalName} · ABN {company.abn} · {company.location} · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a>
    </p>
  </div>
</footer>
