---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import EnquiryModal from '../components/EnquiryModal.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { company, integrations, site } from '../config/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={company.legalName} />
    {
      integrations.googleSiteVerification && (
        <meta name="google-site-verification" content={integrations.googleSiteVerification} />
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap"
    />
  </head>
  <body>
    <a class="sw-skip-link" href="#main">Skip to main content</a>
    <Header path={cleanPath} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <EnquiryModal />
    {
      integrations.cloudflareAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: integrations.cloudflareAnalyticsToken })}
        />
      )
    }
  </body>
</html>
