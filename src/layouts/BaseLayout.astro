---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import EnquiryModal from '../components/EnquiryModal.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { company, integrations, site } from '../config/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra JSON-LD for this page (SEO-07). Organization is added on every page. */
  schema?: Record<string, unknown>[];
}

const { title, description, noindex = false, schema = [] } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;
const ogImage = new URL(site.ogImage.path, site.url).href;
const organizationId = new URL('/#organization', site.url).href;
const organization = {
  '@type': 'Organization',
  '@id': organizationId,
  name: site.name,
  legalName: company.legalName,
  url: site.url,
  logo: new URL(site.logoPath, site.url).href,
  email: company.email,
  identifier: { '@type': 'PropertyValue', propertyID: 'ABN', value: company.abn },
  address: { '@type': 'PostalAddress', addressLocality: company.addressLocality, addressCountry: company.addressCountry },
};
const graph = { '@context': 'https://schema.org', '@graph': [organization, ...schema] };
// Keeps a stray < in a value from closing the script tag.
const jsonLd = JSON.stringify(graph).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImage.alt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="author" content={company.legalName} />
    {
      integrations.googleSiteVerification && (
        <meta name="google-site-verification" content={integrations.googleSiteVerification} />
      )
    }
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&display=swap"
    />
  </head>
  <body>
    <a class="sw-skip-link" href="#main">Skip to main content</a>
    <Header path={cleanPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <EnquiryModal />
    {
      integrations.cloudflareAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: integrations.cloudflareAnalyticsToken })}
        />
      )
    }
  </body>
</html>
