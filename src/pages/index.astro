---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sparkwing: less paperwork, more business with AI"
  description="Hand your manual admin to AI you can check. Sparkwing helps businesses in Australia and the Philippines save hours with trusted AI."
>
  <section class="shell sw-container">
    <h1>Sparkwing</h1>
  </section>
</BaseLayout>

<style>
  .shell {
    padding-block: var(--sw-section-y);
  }

  .shell h1 {
    font-size: var(--sw-text-h1);
    line-height: var(--sw-leading-tight);
    letter-spacing: var(--sw-tracking-display);
  }
</style>
