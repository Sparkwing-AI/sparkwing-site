---
import '../styles/page.css';
import '../styles/home-rework.css';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import CanvasHero from '../components/CanvasHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const lines = [
  { text: 'lower costs.', grad: 'sw-grad--aqua-violet' },
  { text: 'boost sales.', grad: 'sw-grad--violet-peach' },
  { text: 'cut paperwork.', grad: 'sw-grad--peach-coral' },
  { text: 'serve customers.', grad: 'sw-grad--aqua-peach' },
  { text: 'save time.', grad: 'sw-grad--gold-peach' },
];

const services = [
  {
    name: 'AI plan',
    text: 'Find the jobs where AI will save the most time, and agree the rules for using it safely.',
    image: '/assets/illustrations/services/svc-01-ai-plan.png',
    alt: 'Two colleagues building an AI plan beside a board with three coloured panels',
  },
  {
    name: 'AI setup',
    text: 'Get your documents, your people and your first apps ready, so your team can start using AI on real work.',
    image: '/assets/illustrations/services/svc-02-ai-setup.png',
    alt: 'A colleague holding folders beside another with a laptop, getting AI set up',
  },
  {
    name: 'AI helpers',
    text: 'Set up AI helpers for the jobs your team repeats, like sorting the inbox or drafting a report.',
    image: '/assets/illustrations/services/svc-03-ai-helpers.png',
    alt: 'Two colleagues reviewing an app on a tablet in front of a web page',
  },
  {
    name: 'AI training',
    text: 'Online learning and training for confident, safe AI use.',
    image: '/assets/illustrations/services/svc-04-ai-coaching.png',
    alt: 'A coach showing a colleague how to use AI on a laptop',
  },
];

const steps = [
  {
    kicker: 'Step 1',
    free: true,
    title: 'Discovery call',
    body: 'Tell us what takes up your time and where you expect AI to help.',
    image: '/assets/illustrations/steps/step-01-discovery-call.png',
    alt: 'Two people on the phone, talking through their business',
    crop: 'home-crop-1',
  },
  {
    kicker: 'Step 2',
    title: 'AI readiness check',
    body: 'We look at your processes, data and tools to see what is ready for AI today.',
    image: '/assets/illustrations/steps/step-02-ai-readiness.png',
    alt: 'A colleague pointing to a checklist with three items ticked',
    crop: 'home-crop-2',
  },
  {
    kicker: 'Step 3',
    title: 'Your AI plan',
    body: 'Together we plan what success looks like, the rules, your people and the apps.',
    image: '/assets/illustrations/steps/step-03-ai-plan.png',
    alt: 'A colleague presenting a plan as a row of coloured steps',
    crop: 'home-crop-3',
  },
  {
    kicker: 'Step 4',
    title: 'Team training',
    body: 'Your team learns to use AI with confidence on their own day-to-day work.',
    image: '/assets/illustrations/steps/step-04-team-training.png',
    alt: 'A team member watching a training video on a laptop',
    crop: 'home-crop-4',
  },
  {
    kicker: 'Step 5',
    title: 'Review and adjust',
    body: 'We check progress and adjust. We stay with you until the agreed milestones are met.',
    image: '/assets/illustrations/steps/step-05-review-adjust.png',
    alt: 'Two colleagues reviewing results together on a tablet',
    crop: 'home-crop-5',
  },
];

const apps = [
  {
    name: 'Sparkkeeper',
    href: '/apps#sparkkeeper',
    logo: '/assets/logos/sparkkeeper.png',
    body: 'Your records and your clients in one place.',
  },
  {
    name: 'Magnet',
    href: '/apps#magnet',
    logo: '/assets/logos/magnet.svg',
    badge: 'Coming soon',
    body: 'AI for your leads and follow-ups.',
  },
  {
    name: 'Academy',
    href: '/apps#academy',
    logo: '/assets/logos/academy.svg',
    badge: 'Coming soon',
    body: 'Get your team confident with AI.',
  },
];
---

<BaseLayout
  overlayHeader
  schema={[{ '@type': 'WebSite', '@id': new URL('/#website', site.url).href, name: site.name, url: site.url, inLanguage: site.lang, publisher: { '@id': new URL('/#organization', site.url).href } }]}
  title="Sparkwing: AI consulting for growing businesses"
  description="We set up AI around your business and train your team to use it with confidence. AI consulting from Sydney. Book a free discovery call."
>
  <CanvasHero scene="home" titleId="hero-title" label="Animation: a spiral galaxy turns slowly, with a butterfly at its centre.">
    <div class="mx-text" slot="copy">
      <p class="home-kicker">AI consulting for growing businesses</p>
      <h1 class="mx-h1" id="hero-title">
        <span class="sw-visually-hidden">AI that helps lower costs, boost sales, cut paperwork, serve customers and save time.</span>
        <span aria-hidden="true">
          <span>AI that helps</span>
          <span class="home-flip">
            {lines.map((line) => <span class:list={['sw-grad', line.grad]}>{line.text}</span>)}
          </span>
        </span>
      </h1>
      <p class="mx-p">We set up AI around your business and train your team to use it with confidence.</p>
      <div class="mx-cta">
        <Button variant="accent" size="lg" enquiry="call">Book a free discovery call</Button>
        <Button variant="outline" size="lg" href="/services">See how it works</Button>
      </div>
    </div>
  </CanvasHero>

  <section class="sw-band home-why" aria-labelledby="why-title">
    <div class="sw-band-inner">
      <div class="home-section-copy">
        <p class="home-kicker home-kicker--spark">Why use AI</p>
        <h2 class="sw-h2" id="why-title">Businesses using AI report real gains.</h2>
      </div>
      <div class="home-stats-panel">
        <div class="home-stat">
          <h3>More sales</h3>
          <p class="home-stat-figure"><b>91%</b><span>of small businesses using AI say it boosts revenue</span></p>
          <p class="home-stat-source">
            <span>Sources:{'\u00A0'}</span>
            <a href="https://www.salesforce.com/news/stories/smbs-ai-trends-2025/" target="_blank" rel="noopener">Salesforce SMB Trends, Dec 2024<span class="sw-visually-hidden"> (opens in a new tab)</span></a>
            <span>{'\u00A0'}and{'\u00A0'}</span>
            <a href="https://chainstoreage.com/survey-small-businesses-cite-cost-and-time-savings-top-ai-benefits" target="_blank" rel="noopener">Thryv survey, Apr 2026<span class="sw-visually-hidden"> (opens in a new tab)</span></a>
          </p>
        </div>
        <div class="home-stat">
          <h3>Better margins</h3>
          <p class="home-stat-figure"><b>86%</b><span>of small businesses using AI say it improves margins</span></p>
          <p class="home-stat-source">
            <span>Sources:{'\u00A0'}</span>
            <a href="https://www.salesforce.com/news/stories/smbs-ai-trends-2025/" target="_blank" rel="noopener">Salesforce SMB Trends, Dec 2024<span class="sw-visually-hidden"> (opens in a new tab)</span></a>
          </p>
        </div>
        <div class="home-stat">
          <h3>Your time back</h3>
          <p class="home-stat-figure"><b>3 hrs</b><span>saved a week, say 74% of small businesses using AI</span></p>
          <p class="home-stat-source">
            <span>Sources:{'\u00A0'}</span>
            <a href="https://www.ecb.europa.eu/press/blog/date/2026/html/ecb.blog20260826~e1c1a89999.en.html" target="_blank" rel="noopener">European Central Bank, Aug 2026<span class="sw-visually-hidden"> (opens in a new tab)</span></a>
            <span>{'\u00A0'}and{'\u00A0'}</span>
            <a href="https://dynamicbusiness.com/article/commbank-and-openai-are-betting-ai-can-fix-the-tradie-admin-problem" target="_blank" rel="noopener">OpenAI survey of 1,000+ Australian SMBs, Sep 2026<span class="sw-visually-hidden"> (opens in a new tab)</span></a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sw-band home-services" id="services" aria-labelledby="services-title">
    <div class="sw-band-inner">
      <div class="home-section-copy">
        <p class="home-kicker">Our services</p>
        <h2 class="sw-h2" id="services-title">We're here to help your business.</h2>
        <p class="sw-lead">We offer what you need to get started on your AI journey.</p>
      </div>
      <div class="home-svc" data-services data-selected="0">
        <ol class="home-svc-names">
          {
            services.map((service, index) => (
              <li>
                <button type="button" class="home-svc-name" data-svc={index} aria-pressed={index === 0 ? 'true' : 'false'}>
                  {service.name}
                  <span class="home-svc-bar" aria-hidden="true"></span>
                </button>
              </li>
            ))
          }
        </ol>
        <div class="home-svc-stage" aria-live="polite">
          {
            services.map((service, index) => (
              <div class="home-svc-panel" data-panel={index}>
                <span class="home-svc-num">{String(index + 1).padStart(2, '0')}</span>
                <p>{service.text}</p>
              </div>
            ))
          }
          {services.map((service, index) => <img class="home-svc-art" data-panel={index} src={service.image} alt={service.alt} width="640" height="480" />)}
        </div>
      </div>
    </div>
  </section>

  <section class="sw-band home-tailor" id="how" aria-labelledby="how-title">
    <div class="sw-band-inner">
      <div class="home-section-copy">
        <p class="home-kicker">How it works</p>
        <h2 class="sw-h2" id="how-title">How we tailor AI to what you need.</h2>
        <p class="sw-lead">From the first chat to getting your apps set up and your team trained, we're with you every step of the way.</p>
      </div>
      <ol class="home-steps">
        {
          steps.map((step) => (
            <li class="home-step">
              <img class:list={['home-step-thumb', step.crop]} src={step.image} alt={step.alt} width="112" height="112" />
              <div class="home-step-kicker">
                <span>{step.kicker}</span>
                {step.free && <Badge size="sm" tone="success">Free</Badge>}
              </div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="sw-actions">
        <Button variant="accent" size="lg" href="/services#steps">See the full process</Button>
      </div>
    </div>
  </section>

  <section class="sw-band home-apps" id="apps" aria-labelledby="apps-title">
    <div class="sw-band-inner">
      <div class="home-section-copy">
        <p class="home-kicker home-kicker--spark">Our apps</p>
        <h2 class="sw-h2" id="apps-title">We bring the tools, you bring the papers.</h2>
        <p class="sw-lead">Apps that take on the manual admin, manage your leads and train your team, all customised to your business.</p>
      </div>
      <div class="home-app-row">
        {
          apps.map((app) => (
            <a class="home-app" href={app.href}>
              <span class="home-app-badge">{app.badge && <Badge size="sm">{app.badge}</Badge>}</span>
              <h3 class="home-app-name">
                <img src={app.logo} alt="" width="48" height="48" />
                {app.name}
              </h3>
              <p>{app.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sw-band sw-band--gold home-close" id="contact" aria-labelledby="close-title">
    <div class="sw-band-inner sw-band-inner--row">
      <div class="sw-gold-copy">
        <h2 class="sw-h2" id="close-title">Ready to see where AI fits in your business?</h2>
        <p>Book a free discovery call. Tell us your goals and what takes up your time, <span class="home-close-tail">and we'll map out where AI can help.</span></p>
      </div>
      <Button variant="deep" size="lg" enquiry="call">Book a discovery call</Button>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-services]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-svc]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;

    const select = (index: number) => {
      root.dataset.selected = String(index);
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
    };

    const start = () => {
      window.clearInterval(timer);
      if (reduce.matches) return;
      timer = window.setInterval(() => {
        if (document.documentElement.hasAttribute('data-paused')) return;
        select((Number(root.dataset.selected || '0') + 1) % buttons.length);
      }, 4000);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        select(Number(button.dataset.svc));
        start();
      });
    });

    select(0);
    root.classList.add('is-ready');
    start();
    new MutationObserver(start).observe(document.documentElement, { attributes: true, attributeFilter: ['data-paused'] });
    reduce.addEventListener('change', () => {
      if (reduce.matches) select(0);
      start();
    });
  }
</script>
