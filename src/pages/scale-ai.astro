---
import '../styles/page.css';
import '../styles/inner.css';
import '../styles/scale.css';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import CanvasHero from '../components/CanvasHero.astro';
import FlowStage from '../components/FlowStage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const method = [
  { title: 'Discover', body: 'Your goals, your rules, and where AI is already in use, shaped into your AI strategy.' },
  { title: 'Build', body: 'Your knowledge library, your AI specialists and the apps your team needs.' },
  { title: 'Govern', body: 'Permissions, an off switch, cost tracking and a record of what the AI did.' },
  { title: 'Enable', body: 'Training and a home base, so people use it well and keep using it.' },
  { title: 'Scale', body: "See what's working, then roll it out to more teams." },
];

const tools = [
  {
    name: 'Control Tower',
    href: '/trust#control-tower',
    logo: '/assets/logos/control-tower.svg',
    body: "Governance and guardrails. It decides what's allowed and keeps a record of what the AI did.",
    lead: true,
  },
  {
    name: 'Academy',
    href: '/apps/academy',
    logo: '/assets/logos/academy.svg',
    body: 'Brings your team up to speed and confident with AI, before they use it with real information.',
    soon: true,
  },
  {
    name: 'Nest',
    href: '/apps/nest',
    logo: '/assets/logos/nest.svg',
    body: "One home for your team's AI news, training and app access.",
    soon: true,
  },
  {
    name: 'Spark Studio',
    href: '/spark-studio',
    logo: '/assets/logos/spark-studio.svg',
    body: 'AI strategy, setup, and custom apps or AI agents built around how your organisation works.',
  },
];
---

<BaseLayout
  title="AI governance and training for your team, Sparkwing"
  description="AI strategy, AI governance and AI training for your whole team, with rules and records in place. Built for organisations that need to show their work."
>
  <CanvasHero
    scene="flow"
    ground="navy"
    titleId="sc-title"
    label="Animation: teams across the business pass through Control Tower and come out with approved use, kept records and training."
  >
    <div class="mx-text" slot="copy">
      <span class="mx-eyebrow">I want my whole team using AI safely</span>
      <h1 class="mx-h1 mx-h1--compact" id="sc-title">Bring your whole team along, with rules and records in place.</h1>
      <p class="mx-p">
        Your people are already using AI. We help you turn that into real change across your organisation, with a clear strategy, your business context, the right tools, training and rules. Built for organisations that need to show their work.
      </p>
      <div class="mx-cta">
        <Button variant="accent" size="lg" enquiry="call">Book a discovery call</Button>
      </div>
    </div>
    <FlowStage
      slot="stage"
      logo="/assets/logos/control-tower.svg"
      inputs={['Finance', 'Operations', 'Sales']}
      outputs={['Approved use', 'Records kept', 'Training']}
    />
  </CanvasHero>

  <section class="sw-band sw-band--surface" aria-labelledby="sc-method">
    <div class="sw-band-inner sw-stack">
      <h2 class="sw-h2" id="sc-method">How we work with you</h2>
      <ol class="sw-steps sw-steps--tint">
        {
          method.map((step) => (
            <li>
              <b>{step.title}</b>
              <span>{step.body}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sw-band" aria-labelledby="sc-tools">
    <div class="sw-band-inner sw-stack">
      <h2 class="sw-h2" id="sc-tools">What your team gets to work with</h2>
      <div class="sc-tools">
        {
          tools.map((tool) => (
            <a class:list={['sc-tool', tool.lead && 'sc-tool--lead']} href={tool.href}>
              <span class="sc-tool-head">
                <span class="sc-tool-name">
                  <img src={tool.logo} alt="" width="40" height="40" />
                  {tool.name}
                </span>
                {tool.soon && <Badge>Coming soon</Badge>}
              </span>
              <p>{tool.body}</p>
            </a>
          ))
        }
      </div>
      <p class="sw-lead">
        Strict rules on where data lives? Hybrid keeps your records on your own server. On-prem, coming soon, keeps everything, including the AI, on your own server.
      </p>
    </div>
  </section>
</BaseLayout>
