---
import '../styles/page.css';
import '../styles/inner.css';
import '../styles/studio.css';
import Button from '../components/Button.astro';
import CanvasHero from '../components/CanvasHero.astro';
import FlowStage from '../components/FlowStage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const services = [
  {
    title: 'AI strategy',
    body: 'Find the jobs where AI will save the most time, and agree the rules for using it safely.',
  },
  {
    title: 'AI setup',
    body: 'Get your documents, your people and your first apps ready, so your team can start using AI on real work.',
  },
  {
    title: 'Custom apps and agents',
    body: "Build an app or an AI helper around how your business works, when the ready-made ones don't fit.",
  },
  {
    title: 'AI coaching',
    body: 'Hands-on coaching so your team is confident using AI well and safely.',
  },
];

const steps = [
  { title: 'We listen', body: 'A discovery call about your goals, your rules and how the work gets done today.' },
  {
    title: 'We recommend',
    body: 'Your AI plan and a quote, made for your business. It might include a ready-made app, a custom build or both.',
  },
  {
    title: 'We build and set up',
    body: 'A small team tries it first, so we can fix what needs fixing before everyone starts.',
  },
  { title: 'You grow', body: "We coach your team on using AI and stay close, and you add more whenever you're ready." },
];

const description = "AI consulting from Sydney. AI strategy, AI systems, custom AI apps and AI agents, built around your business, for businesses across Australia.";
const schema = [
  {
    '@type': 'Service',
    name: 'Spark Studio',
    url: new URL('/spark-studio', site.url).href,
    description,
    serviceType: 'AI strategy and consulting',
    areaServed: [
      { '@type': 'Country', name: 'Australia' },
    ],
    provider: { '@id': new URL('/#organization', site.url).href },
  },
];
---

<BaseLayout
  schema={schema}
  title="AI strategy and consulting, custom AI agents: Spark Studio"
  description={description}
>
  <CanvasHero
    scene="flow"
    titleId="ss-title"
    label="Animation: your workflows, rules and tools flow into Spark Studio and come out as a custom app, an AI agent and a team that is set up."
  >
    <div class="mx-text" slot="copy">
      <span class="mx-mark">
        <img src="/assets/logos/spark-studio.svg" alt="" width="56" height="56" />
        <span class="mx-eyebrow">Spark Studio</span>
      </span>
      <h1 class="mx-h1 mx-h1--compact" id="ss-title">Spark Studio customises your AI journey</h1>
      <p class="mx-p">AI strategy, setup, tailored apps, and AI coaching for your team</p>
      <div class="mx-cta">
        <Button variant="accent" size="lg" enquiry="studio">Book a discovery call</Button>
      </div>
    </div>
    <FlowStage
      slot="stage"
      logo="/assets/logos/spark-studio.svg"
      inputs={['Your workflows', 'Your rules', 'Your tools']}
      outputs={['Custom app', 'AI agent', 'Team set up']}
    />
  </CanvasHero>

  <section class="sw-band sw-band--surface" aria-labelledby="ss-do">
    <div class="sw-band-inner sw-stack">
      <h2 class="sw-h2" id="ss-do">What we can do for you.</h2>
      <div class="sw-cards">
        {
          services.map((service) => (
            <div class="sw-card">
              <h3>{service.title}</h3>
              <p>{service.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sw-band" aria-labelledby="ss-how">
    <div class="sw-band-inner sw-stack">
      <h2 class="sw-h2" id="ss-how">How we work with you.</h2>
      <ol class="sw-steps">
        {
          steps.map((step) => (
            <li>
              <b>{step.title}</b>
              <span>{step.body}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sw-band sw-band--surface sw-base" aria-labelledby="ss-trust">
    <div class="sw-base-grid">
      <h2 class="sw-base-title" id="ss-trust">Custom work, on the same trusted base.</h2>
      <div class="sw-base-copy">
        <p>
          What we build runs on the same base as every Sparkwing app. Your business context stays in one place, you set the rules, and you check AI drafts before they go out. We don't use your data to train AI models.
        </p>
        <a class="sw-link" href="/how-it-works">See how it works</a>
      </div>
    </div>
  </section>

  <section class="sw-band sw-band--gold" aria-labelledby="ss-cta">
    <div class="sw-band-inner sw-band-inner--row">
      <div class="sw-gold-copy">
        <h2 id="ss-cta">Ready to talk about your business?</h2>
        <p>Book a discovery call and tell us where the time goes.</p>
      </div>
      <Button variant="deep" size="lg" enquiry="studio">Book a discovery call</Button>
    </div>
  </section>
</BaseLayout>
