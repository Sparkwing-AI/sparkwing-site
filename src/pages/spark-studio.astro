---
import '../styles/page.css';
import '../styles/motion.css';
import '../styles/inner.css';
import '../styles/studio.css';
import Button from '../components/Button.astro';
import MotionTrigger from '../components/MotionTrigger.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  { title: 'AI consulting', body: 'Find the jobs where AI will save the most time, and agree the rules for using it safely.' },
  {
    title: 'AI setup',
    body: 'Get your documents, your people and your first apps ready, so your team can start using AI on real work.',
  },
  { title: 'Custom apps', body: "Build an app around how your business works, when the ready-made ones don't fit." },
  {
    title: 'AI agents',
    body: 'Build AI helpers for the repeat work in your team, like an inbox sorter or a report writer.',
  },
];

const steps = [
  { title: 'We listen', body: 'A discovery call about your goals, your rules and how the work gets done today.' },
  {
    title: 'We recommend',
    body: 'A plan and quote made for your business. It might be a ready-made app, a custom build or both.',
  },
  {
    title: 'We build and set up',
    body: 'A small team tries it first, so we can fix what needs fixing before everyone starts.',
  },
  { title: 'You grow', body: "We train your people and stay close, and you add more whenever you're ready." },
];
---

<BaseLayout
  title="Spark Studio: AI consulting, custom apps and agents"
  description="Sparkwing's AI consulting team. We set AI up around your business and build custom apps or AI agents when you need more."
>
  <section class="ph ph--deep" aria-labelledby="ss-title">
    <div class="ph-grid">
      <div class="ph-copy">
        <span class="ph-eyebrow">
          <img src="/assets/logos/spark-studio.svg" alt="" width="44" height="44" />
          Spark Studio · AI consulting
        </span>
        <h1 class="ph-h1" id="ss-title">AI set up around your business, and built for it when you need more.</h1>
        <p class="ph-lead">
          Spark Studio is Sparkwing's AI consulting team. We work out where AI will help, set it up properly, and build custom apps or AI agents when the ready-made apps don't cover what you need.
        </p>
        <Button variant="accent" size="lg" enquiry="studio">Book a discovery call</Button>
      </div>

      <div class="ph-scene-wrap">
        <div
          class="ph-scene"
          role="img"
          aria-label="Animation: a custom app is built piece by piece, then an AI agent joins it."
        >
          <div class="ss-app">
            <span class="mv-pop ss-piece ss-piece--bar"></span>
            <span class="mv-pop ss-piece ss-piece--side mv-d3"></span>
            <span class="mv-pop ss-piece ss-piece--a mv-d5"></span>
            <span class="mv-pop ss-piece ss-piece--b mv-d8"></span>
            <span class="mv-pop ss-piece ss-piece--c mv-d10"></span>
          </div>
          <span class="mv-pop mv-chip ss-tag ss-tag--app mv-d13">Custom app</span>
          <span class="mv-pop mv-chip ss-tag ss-tag--agent mv-d17">
            <img src="/assets/logos/ai-crew.svg" alt="" width="22" height="22" />
            AI agent
          </span>
          <svg class="mv-twinkle ph-star" viewBox="-12 -12 24 24" aria-hidden="true" focusable="false">
            <path d="M0-12Q1.5-1.5 12 0Q1.5 1.5 0 12Q-1.5 1.5-12 0Q-1.5-1.5 0-12Z"></path>
          </svg>
        </div>
        <MotionTrigger />
      </div>
    </div>
  </section>

  <section class="sw-band sw-band--surface" aria-labelledby="ss-do">
    <div class="sw-band-inner sw-stack">
      <h2 class="sw-h2" id="ss-do">What we can do for you</h2>
      <div class="sw-cards">
        {
          services.map((service) => (
            <div class="sw-card">
              <h3>{service.title}</h3>
              <p>{service.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sw-band" aria-labelledby="ss-how">
    <div class="sw-band-inner sw-stack">
      <h2 class="sw-h2" id="ss-how">How we work with you</h2>
      <ol class="sw-steps">
        {
          steps.map((step) => (
            <li>
              <b>{step.title}</b>
              <span>{step.body}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="sw-band sw-band--surface sw-base" aria-labelledby="ss-trust">
    <div class="sw-base-grid">
      <h2 class="sw-base-title" id="ss-trust">Custom work, on the same trusted base.</h2>
      <div class="sw-base-copy">
        <p>
          What we build is designed to run on the same base platform as every Sparkwing app. Hive knows your business, and Control Tower decides what's allowed and keeps a record of what the AI did. We don't use your data to train AI models.
        </p>
        <a class="sw-link" href="/trust">How the base platform works</a>
      </div>
    </div>
  </section>
</BaseLayout>
