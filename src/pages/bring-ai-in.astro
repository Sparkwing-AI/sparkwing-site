---
import '../styles/page.css';
import '../styles/motion.css';
import '../styles/inner.css';
import '../styles/start.css';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import MotionTrigger from '../components/MotionTrigger.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const steps = [
  { title: 'We listen', body: "A discovery call about your goals and what's in the way. Show and tell comes later." },
  { title: 'We recommend', body: 'A recommendation and quote made for your business, in Australian dollars or pesos.' },
  { title: 'We set you up', body: 'Your space, your users and your documents, ready for a small team to test first.' },
  { title: 'You grow', body: "Roll out to everyone, then switch on more apps whenever you're ready." },
];

const papers = [
  { tone: '', delay: 0 },
  { tone: 'tint', delay: 2 },
  { tone: 'muted', delay: 3 },
  { tone: '', delay: 5 },
  { tone: 'tint', delay: 7 },
];
---

<BaseLayout
  title="Bring AI into your business, Sparkwing"
  description="Start with the job that eats the most hours. No IT team or big plan needed. For growing businesses in Australia and the Philippines."
>
  <section class="ph" aria-labelledby="st-title">
    <div class="ph-grid">
      <div class="ph-copy">
        <span class="ph-eyebrow">I want to bring AI into my business</span>
        <h1 class="ph-h1" id="st-title">Less paperwork, starting with one app.</h1>
        <p class="ph-lead">
          For growing businesses in Australia and the Philippines. You don't need an IT team or a big plan. Start with the job that eats the most hours, and we run the rest for you.
        </p>
        <div class="ph-actions">
          <Button variant="primary" size="lg" enquiry="call">Book a discovery call</Button>
          <Button variant="outline" size="lg" href={site.demoUrl}>Try Sparkkeeper</Button>
        </div>
      </div>

      <div class="ph-scene-wrap">
        <div
          class="ph-scene"
          role="img"
          aria-label="Animation: a pile of paperwork goes into Sparkkeeper, and hours come back."
        >
          {
            papers.map((paper, index) => (
              <span
                class:list={[
                  'mv-fly',
                  'st-paper',
                  `st-paper--${index + 1}`,
                  paper.tone && `st-paper--${paper.tone}`,
                  paper.delay > 0 && `mv-d${paper.delay}`,
                ]}
              >
                <i />
                <i />
                <i />
                <i />
                <i />
              </span>
            ))
          }
          <span class="mv-ring st-ring"></span>
          <span class="mv-ring st-ring mv-d9"></span>
          <img class="mv-glow st-glow" src="/assets/logos/sparkkeeper-on-dark.svg" alt="" width="88" height="88" />
          <span class="mv-pop mv-chip st-hours mv-d22">Hours back</span>
          <svg class="mv-twinkle ph-star st-star" viewBox="-12 -12 24 24" aria-hidden="true" focusable="false">
            <path d="M0-12Q1.5-1.5 12 0Q1.5 1.5 0 12Q-1.5 1.5-12 0Q-1.5-1.5 0-12Z"></path>
          </svg>
        </div>
        <MotionTrigger />
      </div>
    </div>
  </section>

  <section class="sw-band sw-band--surface" aria-labelledby="st-apps">
    <div class="sw-band-inner sw-stack">
      <h2 class="sw-h2" id="st-apps">Where most businesses start</h2>
      <div class="st-cards">
        <a class="st-card st-card--deep" href="/sparkkeeper">
          <span class="st-card-head">
            <span class="st-card-name">
              <img src="/assets/logos/sparkkeeper-on-dark.svg" alt="" width="44" height="44" />
              Sparkkeeper
            </span>
            <Badge tone="success">Beta</Badge>
          </span>
          <p>
            If bookkeeping and slow reports are taking your hours. Start from your Excel files, receipts and invoices, and keep your numbers and clients in one place.
          </p>
        </a>
        <a class="st-card" href="/apps/magnet">
          <span class="st-card-head">
            <span class="st-card-name">
              <img src="/assets/logos/magnet.svg" alt="" width="44" height="44" />
              Magnet
            </span>
            <Badge>Coming soon</Badge>
          </span>
          <p>If follow-ups and renewals keep slipping, or new clients are hard to find.</p>
        </a>
        <a class="st-card" href="/spark-studio">
          <span class="st-card-name">
            <img src="/assets/logos/spark-studio.svg" alt="" width="44" height="44" />
            Spark Studio
          </span>
          <p>If you need AI set up for you, or an app or AI agent built around how you work.</p>
        </a>
        <a class="st-card" href="mailto:info@sparkwing.com.au" data-enquiry="call">
          <span class="st-card-name">Accounting firms</span>
          <p>
            If you keep records for many clients and want AI your whole firm can trust. Let's talk about what would help most.
          </p>
        </a>
      </div>
      <p class="sw-lead">
        Sparkkeeper sits alongside your registered books and invoicing. <a class="sw-link" href="/sparkkeeper#scope">See what it covers today</a>
      </p>
    </div>
  </section>

  <section class="sw-band" aria-labelledby="st-how">
    <div class="sw-band-inner sw-stack">
      <h2 class="sw-h2" id="st-how">How we get you off the ground</h2>
      <ol class="sw-steps sw-steps--num">
        {
          steps.map((step, index) => (
            <li>
              <b class="sw-step-n" aria-hidden="true">{index + 1}</b>
              <b>{step.title}</b>
              <span>{step.body}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
