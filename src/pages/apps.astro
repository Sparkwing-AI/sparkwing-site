---
import { site } from '../config/site';
const target = new URL('/apps/magnet', site.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <title>Magnet: fewer missed follow-ups, Sparkwing</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content="0; url=/apps/magnet" />
  </head>
  <body>
    <p><a href="/apps/magnet">Go to Magnet</a></p>
  </body>
</html>
