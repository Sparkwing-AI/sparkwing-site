---
import '../styles/page.css';
import '../styles/hero-motion.css';
import '../styles/home-rework.css';
import '../styles/apps-hub.css';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import MotionTrigger from '../components/MotionTrigger.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  overlayHeader
  title="Sparkwing apps: Sparkkeeper, Magnet and Academy"
  description="Apps that take on the paperwork, look after your leads and train your team, all customised to your business."
>
  <section class="mx-hero apps-hero" data-ground="deep" aria-labelledby="apps-hero-title">
    <canvas class="mx-canvas" data-apps-sky aria-hidden="true"></canvas>
    <div class="mx-veil"></div>
    <div class="mx-grid sw-container">
      <div class="mx-text">
        <p class="home-kicker">Our apps</p>
        <h1 class="mx-h1" id="apps-hero-title"><span class="mx-h1-line">The tools that</span> <span class="mx-h1-line"><span class="sw-grad sw-grad--spectrum">take on the admin</span>.</span></h1>
        <p class="mx-p">Apps that take on the paperwork, look after your leads and train your team, all customised to your business.</p>
        <div class="mx-cta">
          <Button variant="accent" size="lg" enquiry="demo">Request a demo</Button>
          <Button variant="outline" size="lg" href="#sparkkeeper">See the apps</Button>
        </div>
      </div>
      <div class="mx-stage" role="img" aria-label="Animation: the Sparkkeeper, Magnet and Academy app icons, drawn as glowing outlines, float gently and link up under a starry sky with meteors.">
        <svg class="ap-lines" aria-hidden="true" viewBox="0 0 600 440" preserveAspectRatio="none">
          <defs>
            <radialGradient id="ap-glow">
              <stop offset="0" stop-color="var(--sw-color-on-deep)" stop-opacity="0.95"></stop>
              <stop offset="0.3" stop-color="var(--sw-color-on-deep-soft)" stop-opacity="0.45"></stop>
              <stop offset="1" stop-color="var(--sw-brand-lagoon-bright)" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <line x1="176" y1="92" x2="424" y2="108"></line>
          <line x1="176" y1="152" x2="236" y2="250"></line>
          <line x1="424" y1="178" x2="364" y2="250"></line>
        </svg>
        <div class="ap-node ap-node--keeper">
          <div class="ap-float">
            <svg class="ap-out" viewBox="0 0 96 96" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect class="ap-box" x="3" y="3" width="90" height="90" rx="24"></rect>
              <path class="ap-glyph" d="M48 32c-7-5-15-6-25-5v41c10-1 18 0 25 5 7-5 15-6 25-5V27c-10-1-18 0-25 5Z"></path>
              <path class="ap-glyph" d="M48 32v41M31 40c4 0 7 .5 10 2M31 51c4 0 7 .5 10 2M55 42c3-1.5 6-2 10-2M55 53c3-1.5 6-2 10-2"></path>
              <path class="ap-gold" transform="translate(74 22) scale(0.95)" d="M0-12Q1.5-1.5 12 0Q1.5 1.5 0 12Q-1.5 1.5-12 0Q-1.5-1.5 0-12Z"></path>
              <g class="ap-st" transform="translate(10 10)"><circle r="9" fill="url(#ap-glow)"></circle><circle r="1.6" fill="var(--sw-color-on-deep)"></circle><path d="M-5 0H5M0-5V5"></path></g>
              <g class="ap-st" transform="translate(86 86)"><circle r="9" fill="url(#ap-glow)"></circle><circle r="1.6" fill="var(--sw-color-on-deep)"></circle><path d="M-5 0H5M0-5V5"></path></g>
              <g class="ap-st" transform="translate(86 10)"><circle r="6" fill="url(#ap-glow)"></circle></g>
              <g class="ap-st" transform="translate(10 86)"><circle r="6" fill="url(#ap-glow)"></circle></g>
            </svg>
            <span class="ap-name">Sparkkeeper</span>
          </div>
        </div>
        <div class="ap-node ap-node--magnet">
          <div class="ap-float ap-float--b">
            <svg class="ap-out" viewBox="0 0 96 96" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect class="ap-box" x="3" y="3" width="90" height="90" rx="24"></rect>
              <path class="ap-glyph" d="M21 34V50a27 27 0 0 0 54 0V34H61V50a13 13 0 0 1-26 0V34Z"></path>
              <path class="ap-gold" d="M21 24H35V34H21ZM61 24H75V34H61Z"></path>
              <path class="ap-gold" transform="translate(48 26) scale(0.8)" d="M0-12Q1.5-1.5 12 0Q1.5 1.5 0 12Q-1.5 1.5-12 0Q-1.5-1.5 0-12Z"></path>
              <g class="ap-st" transform="translate(10 10)"><circle r="9" fill="url(#ap-glow)"></circle><circle r="1.6" fill="var(--sw-color-on-deep)"></circle><path d="M-5 0H5M0-5V5"></path></g>
              <g class="ap-st" transform="translate(86 86)"><circle r="9" fill="url(#ap-glow)"></circle><circle r="1.6" fill="var(--sw-color-on-deep)"></circle><path d="M-5 0H5M0-5V5"></path></g>
              <g class="ap-st" transform="translate(86 10)"><circle r="6" fill="url(#ap-glow)"></circle></g>
              <g class="ap-st" transform="translate(10 86)"><circle r="6" fill="url(#ap-glow)"></circle></g>
            </svg>
            <span class="ap-name">Magnet</span>
          </div>
        </div>
        <div class="ap-node ap-node--academy">
          <div class="ap-float ap-float--c">
            <svg class="ap-out" viewBox="0 0 96 96" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect class="ap-box" x="3" y="3" width="90" height="90" rx="24"></rect>
              <path class="ap-glyph" d="M48 26 14 42l34 16 34-16-34-16Z"></path>
              <path class="ap-glyph" d="M28 50v15c11 8 29 8 40 0V50"></path>
              <path class="ap-gold" d="M78 44v16"></path>
              <path class="ap-gold" transform="translate(78 68) scale(0.6)" d="M0-12Q1.5-1.5 12 0Q1.5 1.5 0 12Q-1.5 1.5-12 0Q-1.5-1.5 0-12Z"></path>
              <g class="ap-st" transform="translate(10 10)"><circle r="9" fill="url(#ap-glow)"></circle><circle r="1.6" fill="var(--sw-color-on-deep)"></circle><path d="M-5 0H5M0-5V5"></path></g>
              <g class="ap-st" transform="translate(86 86)"><circle r="9" fill="url(#ap-glow)"></circle><circle r="1.6" fill="var(--sw-color-on-deep)"></circle><path d="M-5 0H5M0-5V5"></path></g>
              <g class="ap-st" transform="translate(86 10)"><circle r="6" fill="url(#ap-glow)"></circle></g>
              <g class="ap-st" transform="translate(10 86)"><circle r="6" fill="url(#ap-glow)"></circle></g>
            </svg>
            <span class="ap-name">Academy</span>
          </div>
        </div>
      </div>
    </div>
    <MotionTrigger corner="bottom-right" />
  </section>

  <section class="sw-band apps-band apps-band--silk" id="sparkkeeper" aria-labelledby="sk-name">
    <div class="sw-band-inner">
      <div class="apps-row">
        <div class="apps-copy">
          <Badge tone="success">Beta</Badge>
          <h2 id="sk-name">Sparkkeeper</h2>
          <p class="apps-promise">Less time on your books, more on your business.</p>
          <p class="sw-lead">Your records and clients in one place, with an AI helper that does the manual admin and shows its work.</p>
          <ul class="apps-list">
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>AI types in your invoices and client details for you</span></li>
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Ask the chat to find any record or detail</span></li>
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Create reports easily from templates</span></li>
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>AI sends follow-up emails and books calendar meetings with your clients</span></li>
          </ul>
          <Button variant="accent" size="lg" href="/sparkkeeper/beta">Sign up for the beta</Button>
        </div>
        <div class="apps-shot" role="img" aria-label="The Sparkkeeper Today screen, showing client numbers, policies that need attention and the Ask Sparky helper">
          <img class="apps-win" src="/assets/apps/sparkkeeper-today.png" alt="" width="1024" height="616" />
        </div>
      </div>
    </div>
  </section>

  <section class="sw-band apps-band apps-band--white" aria-label="Magnet and Academy">
    <div class="sw-band-inner">
      <div class="apps-pair">
        <div class="apps-copy" id="magnet">
          <Badge>Coming soon</Badge>
          <h2 id="mg-name">Magnet</h2>
          <p class="apps-promise">Put AI to work on growing your business.</p>
          <p class="sw-lead">Magnet looks after your leads from first enquiry to sign-up, with fewer missed follow-ups and renewals.</p>
          <ul class="apps-list">
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Replies to enquiries on your website 24/7</span></li>
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Sends reminders so nobody slips</span></li>
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Runs simple campaigns</span></li>
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Turns new sign-ups into clients in Sparkkeeper</span></li>
          </ul>
          <Button variant="deep" size="lg" enquiry="demo">Ask us about this app</Button>
        </div>
        <div class="apps-copy" id="academy">
          <Badge>Coming soon</Badge>
          <h2 id="ac-name">Academy</h2>
          <p class="apps-promise">Get your team up to speed and confident using AI.</p>
          <p class="sw-lead">Short online courses that help your team use your AI apps confidently and responsibly.</p>
          <ul class="apps-list">
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Short courses, made for busy teams</span></li>
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Safe AI habits for everyday work</span></li>
            <li><span class="apps-tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>Finishing a course can unlock achievements and certificates</span></li>
          </ul>
          <Button variant="deep" size="lg" enquiry="demo">Ask us about this app</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="sw-band sw-band--gold apps-close" id="contact" aria-labelledby="apps-close-title">
    <div class="sw-band-inner sw-band-inner--row">
      <div class="sw-gold-copy">
        <h2 class="sw-h2" id="apps-close-title">Want to know more about these apps?</h2>
        <p>Contact us for a demo and we'll show you how our apps can clear admin and give you back your time.</p>
      </div>
      <Button variant="deep" size="lg" enquiry="demo">Request a demo</Button>
    </div>
  </section>
</BaseLayout>

<script>
  import { startAppsSky } from '../scripts/apps-sky.js';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-apps-sky]');
  if (canvas) startAppsSky(canvas);
</script>
