# Sparkkeeper login address. Launch blocker: confirm before launch.
PUBLIC_APP_URL=https://sparkkeeper.com.au/
# Pending: replace with a Sparkwing domain before launch.
PUBLIC_DEMO_URL=https://sparkkeeper.moxie-strife.workers.dev/
# Shows bracketed placeholders in `npm run dev` only. Any build with this on fails the placeholder check.
PUBLIC_SHOW_PLACEHOLDERS=false
# Base URL of the forms Worker (CORE-189), for example https://sparkwing-forms.<subdomain>.workers.dev
# While unset, the enquiry modal only shows its confirmation in `npm run dev`. Production shows the failure message.
PUBLIC_FORM_ENDPOINT=
# Ask Sparky. Off until the chat Worker, Turnstile and Privacy update are ready (CHATBOT.md).
# Leave this false for any build that might be deployed.
PUBLIC_CHAT_ENABLED=false
# Chat endpoint, including /api/chat. Never put an API key in this file.
# PUBLIC_CHAT_ENDPOINT=http://127.0.0.1:8788/api/chat
# Public Turnstile site key. Not a secret.
# PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Web Analytics site token (FR-601). Rendered in production builds only. Elly supplies it before launch.
PUBLIC_CF_ANALYTICS_TOKEN=
# Google Search Console HTML tag verification code. Rendered in production builds only. Adds no script.
PUBLIC_GOOGLE_SITE_VERIFICATION=
