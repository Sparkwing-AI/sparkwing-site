{
  "name": "sparkwing-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "npm run lint:css && npm run lint:source && npm run lint:astro && npm run lint:workers",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:source": "node scripts/check-source.mjs",
    "lint:astro": "astro check",
    "prebuild": "npm run lint:css && npm run lint:source",
    "build": "astro build && node scripts/check-dist.mjs",
    "preview": "astro preview --port 4321",
    "build:og": "node scripts/make-og.mjs",
    "lint:workers": "tsc -p workers/tsconfig.json",
    "test:legal": "node scripts/check-legal.mjs",
    "chat:dev": "npx wrangler dev --config workers/chat/wrangler.toml",
    "test:chat": "node --experimental-strip-types workers/chat/test/model-checks.ts",
    "test:leads": "node --experimental-strip-types --import ./workers/leads/test/register.mjs workers/leads/test/access.test.ts",
    "test:links": "linkinator dist --config linkinator.config.json",
    "test:a11y": "playwright test",
    "test:lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "linkinator": "8.1.0",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "wrangler": "4.156.2"
  }
}
